<Project>
  <!--
    The Directory.Build.targets of a solution above, when this library is a module of one (annium-lang, PotoHEX: the
    headers and libraries of its Otok/ through its otok.targets); then, when numetron is built alone (Directory.Build.props
    imported Otok/otok.props), the headers and libraries of its own Otok/ (otok.toml).
  -->
  <PropertyGroup>
    <_ParentDirectoryBuildTargetsFile>$([MSBuild]::GetPathOfFileAbove('Directory.Build.targets', '$(MSBuildThisFileDirectory)../'))</_ParentDirectoryBuildTargetsFile>
  </PropertyGroup>
  <Import Project="$(_ParentDirectoryBuildTargetsFile)" Condition="'$(_ParentDirectoryBuildTargetsFile)' != ''" />

  <Import Project="$(MSBuildThisFileDirectory)Otok\otok.targets" Condition="'$(NumetronOwnOtok)' == 'true'" />
</Project>
